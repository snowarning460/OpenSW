3. Domain Analysis .....................................................................

3.1 User
- 시스템을 사용하는 사용자
- 일정 등록, 수정, 삭제 기능 수행

3.2 Schedule
- 일정 정보를 저장하는 클래스
- 제목, 날짜, 시간, 알림 설정 포함

3.3 Notification
- 일정 알림 정보를 관리하는 클래스
- 알림 시간 및 반복 여부 저장

3.4 Database
- 일정 및 알림 데이터를 저장하는 시스템

3.5 Scheduler
- 알림 시간 체크 및 알림 전송 담당

3.6 UI (User Interface)
- 사용자가 시스템과 상호작용하는 화면

4. UI Prototype ...............................................................

<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<title>일정 관리 시스템</title>
<style>
body { font-family: Arial; margin: 20px; }
input, button { margin: 5px; }
li { margin: 5px 0; }
</style>
</head>
<body>

<h1>📅 일정 관리 시스템</h1>

<input type="text" id="title" placeholder="일정 제목">
<input type="datetime-local" id="time">
<button onclick="addSchedule()">등록</button>

<h2>일정 목록</h2>
<ul id="list"></ul>

<script>
let schedules = JSON.parse(localStorage.getItem("schedules")) || [];

function save() {
    localStorage.setItem("schedules", JSON.stringify(schedules));
}

function render() {
    let list = document.getElementById("list");
    list.innerHTML = "";

    schedules.forEach((s, index) => {
        let li = document.createElement("li");
        li.innerHTML = `
            ${s.title} (${s.time})
            <button onclick="editSchedule(${index})">수정</button>
            <button onclick="deleteSchedule(${index})">삭제</button>
        `;
        list.appendChild(li);
    });
}

function addSchedule() {
    let title = document.getElementById("title").value;
    let time = document.getElementById("time").value;

    if (!title || !time) {
        alert("모든 값을 입력하세요");
        return;
    }

    schedules.push({ title, time, notified: false });
    save();
    render();
}

function deleteSchedule(index) {
    if (confirm("삭제하시겠습니까?")) {
        schedules.splice(index, 1);
        save();
        render();
    }
}

function editSchedule(index) {
    let newTitle = prompt("새 제목", schedules[index].title);
    if (newTitle) {
        schedules[index].title = newTitle;
        save();
        render();
    }
}

// 🔔 알림 기능 (간단 버전)
setInterval(() => {
    let now = new Date().getTime();

    schedules.forEach(s => {
        let scheduleTime = new Date(s.time).getTime();

        if (!s.notified && scheduleTime <= now) {
            alert("📢 일정 알림: " + s.title);
            s.notified = true;
            save();
        }
    });
}, 5000);

render();
</script>

</body>
</html>

